{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "deny": [
            "Read(.env)",
            "Read(.env.*)",
            "Read(!.env.example)",
            "Read(*.pem)",
            "Read(*.key)",
            "Bash(*git push --force*)",
            "Bash(*git push -f *)",
            "Bash(*git push --force-with-lease*)",
            "Bash(*git reset --hard*)",
            "Bash(*artisan migrate:fresh*)",
            "Bash(*artisan migrate:reset*)",
            "Bash(*artisan db:wipe*)",
            "Bash(*make fresh*)",
            "Bash(*docker compose run *)",
            "Bash(*docker compose down -v*)",
            "Bash(*docker compose down --volumes*)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash|PowerShell",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.py\" \"--exec=make artisan|composer|npm ARGS=... albo docker compose exec app <komenda>\"",
                        "timeout": 10,
                        "onFailure": "block"
                    }
                ]
            }
        ]
    }
}
