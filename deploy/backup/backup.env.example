# /etc/starter/backup.env — root-owned, mode 0600. Example values only.
# Read by starter-backup.service (scripts/backup/backup.sh). BACKUP_DIR must
# be writable by www-data (the unit's user); last-success is read by
# ops:check-backup. Set the engine of the application (DB_CONNECTION) and
# only its block of variables.
BACKUP_DB_ENGINE=mysql

# MySQL: a dedicated backup account with SELECT, SHOW VIEW and TRIGGER on the
# application database (mysqldump --single-transaction needs no LOCK TABLES);
# restore drills use a separate account allowed to CREATE/DROP databases. The
# password must not contain quotes, backslashes or newlines.
MYSQL_HOST=127.0.0.1
MYSQL_TCP_PORT=3306
MYSQL_DATABASE=starter
MYSQL_USER=starter_backup
MYSQL_PASSWORD=change-me

# PostgreSQL (BACKUP_DB_ENGINE=pgsql): a read-only role for backups
# (pg_read_all_data) and a separate role with CREATEDB for restore drills.
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=starter
# PGUSER=starter_backup
# PGPASSWORD=change-me

# Local staging directory; ship it off-host (object storage in the EU,
# separate credentials) — see doc 10 "Backup i restore".
BACKUP_DIR=/var/backups/starter
BACKUP_STORAGE_PATH=/var/www/starter/shared/storage/app
BACKUP_STORAGE_DIRS="media public"
BACKUP_KEEP=7
BACKUP_STATUS_FILE=/var/backups/starter/last-success

# Encryption before the files leave the host: none | age | gpg.
BACKUP_ENCRYPT=age
BACKUP_AGE_RECIPIENT=age1examplepublickeyreplacewithoperatorkey0000000000000000000
