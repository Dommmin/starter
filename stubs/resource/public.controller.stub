<?php

namespace App\Http\Controllers\Content;

use App\Data\Content\Public{{ Model }}Data;
use App\Data\Content\Public{{ Model }}ListData;
use App\Data\Content\Public{{ Model }}SummaryData;
use App\Data\Listing\ListPaginationData;
use App\Http\Controllers\Controller;
use App\Models\{{ Model }};
use App\Services\Localization\LocalizationConfig;
use App\Services\Localization\LocalizationManager;
use App\Services\Localization\LocalizedUrlGenerator;
use Illuminate\Http\Request;
use Inertia\Inertia;
use Inertia\Response;
{{ imports }}

/**
 * Public list and detail pages of published {{ pluralLower }} (generated by
 * `app:make-resource --public`). The content has one language: every locale
 * shows the same record and the canonical URL is the default-locale one.
 */
class Public{{ Model }}Controller extends Controller
{
    private const int PER_PAGE = 12;

    public function __construct(
        private readonly LocalizationConfig $config,
        private readonly LocalizationManager $localization,
        private readonly LocalizedUrlGenerator $urls,
{{ dependencies }}
    ) {}

    /**
     * List published {{ pluralLower }}, newest first. A page number beyond the
     * last page is a 404.
     */
    public function index(Request $request): Response
    {
        $locale = $this->localization->getCurrentLocale($request);
        $paginator = {{ Model }}::query()
            ->where('published', true)
            ->latest('id')
            ->paginate(self::PER_PAGE);

        abort_if($paginator->currentPage() > max(1, $paginator->lastPage()), 404);

        $items = [];
        foreach ($paginator->items() as ${{ variable }}) {
            $items[] = Public{{ Model }}SummaryData::fromModel(
                ${{ variable }},
                $this->urls->url('{{ kebabPlural }}.show', ['slug' => ${{ variable }}->slug], $locale),
            );
        }

        return Inertia::render('public/{{ kebabPlural }}/index', new Public{{ Model }}ListData(
            items: $items,
            pagination: new ListPaginationData(
                page: $paginator->currentPage(),
                totalPages: $paginator->lastPage(),
                total: $paginator->total(),
                perPage: $paginator->perPage(),
            ),
            locale: $locale,
        ));
    }

    /**
     * Show one published {{ singularLower }}; an unpublished and an unknown slug
     * are the same 404.
     */
    public function show(Request $request): Response
    {
        $locale = $this->localization->getCurrentLocale($request);
        ${{ variable }} = {{ Model }}::query()
            ->where('published', true)
            ->where('slug', (string) $request->route('slug'))
            ->firstOrFail();

        return Inertia::render('public/{{ kebabPlural }}/show', new Public{{ Model }}Data(
            title: ${{ variable }}->{{ titleColumn }},
            summary: {{ summaryValue }},
            bodyHtml: {{ bodyValue }},
            canonical: $this->urls->url('{{ kebabPlural }}.show', ['slug' => ${{ variable }}->slug], $this->config->getPublicDefault()),
            listUrl: $this->urls->url('{{ kebabPlural }}.index', [], $locale),
            locale: $locale,
            updatedAt: ${{ variable }}->updated_at?->toIso8601String(),
        ));
    }
}
