COMPOSE_PROJECT_NAME=starter-local
APP_PORT=8080
VITE_PORT=5173
MAILPIT_PORT=8025

APP_NAME=Laravel
APP_ENV=local
ADMIN_REQUIRE_TWO_FACTOR=false
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=starter
DB_USERNAME=starter
DB_PASSWORD=local-development-only

CACHE_STORE=redis
CACHE_PREFIX=starter-cache-
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=starter-database-

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_EHLO_DOMAIN=localhost
MAIL_FROM_ADDRESS=hello@example.test
MAIL_FROM_NAME=Laravel

# Contact form recipient (falls back to MAIL_FROM_ADDRESS); retention in days.
# CONTACT_RECIPIENT=office@example.test
# CONTACT_RETENTION_DAYS=180
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
VITE_APP_NAME=Laravel

# SEO defaults (config/seo.php); empty values fall back to APP_NAME/APP_URL.
# SEO_SITE_NAME=
# SEO_DEFAULT_IMAGE=
# SEO_ORGANIZATION_NAME=
# SEO_ORGANIZATION_URL=
# SEO_ORGANIZATION_LOGO=
# SEO_CACHE_MAX_AGE=3600

# DAM (config/media.php). Docker sets CLAMAV_HOST=clamav for app/queue; the
# defaults below fit a native clamd on the same host.
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT=30
# MEDIA_DISK=media
# MEDIA_PUBLIC_DISK=public
# MEDIA_MAX_UPLOAD_KB=51200
# MEDIA_MAX_PIXELS=40000000
