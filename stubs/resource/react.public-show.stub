import {
    Heading,
    Link,
    PublicChrome,
    RichTextContent,
    Section,
    Seo,
    Stack,
    Text,
} from '@/design-system/primitives';
import { useTranslation } from '@/i18n';

/**
 * Public page of one published {{ singularLower }} (generated by
 * `app:make-resource --public`). The content has one language, so every
 * locale points its canonical URL at the default-locale page.
 */
export default function Public{{ Model }}Show({
    title,
    summary,
    bodyHtml,
    canonical,
    listUrl,
    locale,
    updatedAt,
}: App.Data.Content.Public{{ Model }}Data) {
    const { t, formatDate } = useTranslation();

    return (
        <>
            <Seo
                title={title}
                description={summary ?? undefined}
                canonical={canonical}
                jsonLd={{
                    '@context': 'https://schema.org',
                    '@type': 'WebPage',
                    name: title,
                    ...(summary ? { description: summary } : {}),
                    url: canonical,
                    inLanguage: locale,
                    ...(updatedAt ? { dateModified: updatedAt } : {}),
                }}
            />

            <PublicChrome>
                <Section spacing="default" container="reading">
                    <article>
                        <Stack gap="default">
                            <Link href={listUrl}>
                                {t('{{ camelPlural }}.backToList')}
                            </Link>
                            <Stack gap="tight">
                                <Heading level={1} variant="page">
                                    {title}
                                </Heading>
                                {updatedAt && (
                                    <Text variant="caption" tone="muted">
                                        {t('{{ camelPlural }}.updatedOn', {
                                            date: formatDate(updatedAt, {
                                                dateStyle: 'long',
                                            }),
                                        })}
                                    </Text>
                                )}
                                {summary && (
                                    <Text variant="lead" tone="muted">
                                        {summary}
                                    </Text>
                                )}
                            </Stack>
                            {bodyHtml && <RichTextContent html={bodyHtml} />}
                        </Stack>
                    </article>
                </Section>
            </PublicChrome>
        </>
    );
}
