import { Head, router, usePage } from '@inertiajs/react';
import { Pencil, Trash2 } from 'lucide-react';
import { useState } from 'react';
import {
{{ primitives }}
} from '@/design-system/primitives';
import { useTranslation } from '@/i18n';
import { index as adminIndex } from '@/routes/admin';
import {
    create,
    destroy,
    edit,
{{ exportImport }}
    index,
} from '@/routes/admin/{{ kebabPlural }}';

type Row = App.Data.Admin.{{ Plural }}.{{ Model }}ListItemData;
type IndexProps = App.Data.Admin.{{ Plural }}.{{ Model }}IndexData;

/**
 * Admin list of {{ pluralLower }} (generated by `app:make-resource`).
 */
export default function Admin{{ Plural }}Index() {
    const { {{ propNames }} } = usePage<IndexProps>().props;
    const { t, formatDate } = useTranslation();
    const [rowToDelete, setRowToDelete] = useState<Row | null>(null);
    const [isDeleting, setIsDeleting] = useState(false);
{{ labelMaps }}
    const rowTitle = (row: Row) =>
        {{ rowTitle }};

    function confirmDelete() {
        if (!rowToDelete) {
            return;
        }

        setIsDeleting(true);
        router.delete(destroy.url(rowToDelete.id), {
            preserveScroll: true,
            onSuccess: () => setRowToDelete(null),
            onFinish: () => setIsDeleting(false),
        });
    }

    return (
        <>
            <Head title={t('admin.{{ camelPlural }}.title')} />

            <ResourceTable<Row>
                url={index()}
                header={{
                    title: t('admin.{{ camelPlural }}.title'),
{{ headerDescriptionAndActions }}
                }}
                rows={items}
                rowKey={(row) => row.id}
                pagination={pagination}
                filters={filters}
{{ searchableProp }}
                labels={{
                    caption: t('admin.{{ camelPlural }}.tableCaption'),
                    searchLabel: t('admin.{{ camelPlural }}.searchLabel'),
                    searchPlaceholder: t('admin.{{ camelPlural }}.searchPlaceholder'),
                    searchClear: t('admin.{{ camelPlural }}.searchClear'),
                    clearFilters: t('admin.{{ camelPlural }}.clearFilters'),
                    emptyTitle: t('admin.{{ camelPlural }}.emptyTitle'),
                    emptyDescription: t('admin.{{ camelPlural }}.emptyDescription'),
                    noResultsTitle: t('admin.{{ camelPlural }}.emptyFilteredTitle'),
                    noResultsDescription: t('admin.{{ camelPlural }}.emptyFilteredDescription'),
                    errorTitle: t('admin.{{ camelPlural }}.errorTitle'),
                    errorRetry: t('admin.{{ camelPlural }}.errorRetry'),
                    previousPage: t('admin.{{ camelPlural }}.previousPage'),
                    nextPage: t('admin.{{ camelPlural }}.nextPage'),
                    paginationSummary: (range) =>
                        t('admin.{{ camelPlural }}.paginationSummary', range),
                }}
                filterFields={[
{{ filterFields }}
                ]}
                columns={[
{{ columns }}
                ]}
                rowActions={{
                    label: (row) =>
                        t('admin.{{ camelPlural }}.rowActionsLabel', {
                            title: rowTitle(row),
                        }),
                    items: (row) => [
                        {
                            id: 'edit',
                            label: t('admin.{{ camelPlural }}.actionEdit'),
                            icon: Pencil,
                            onSelect: () => router.visit(edit.url(row.id)),
                        },
                        ...(can.delete
                            ? [
                                  {
                                      id: 'delete',
                                      label: t('admin.{{ camelPlural }}.actionDelete'),
                                      icon: Trash2,
                                      tone: 'destructive' as const,
                                      onSelect: () => setRowToDelete(row),
                                  },
                              ]
                            : []),
                    ],
                }}
            />

            <ConfirmDialog
                open={rowToDelete !== null}
                onOpenChange={(open) => {
                    if (!open) {
                        setRowToDelete(null);
                    }
                }}
                title={t('admin.{{ camelPlural }}.deleteTitle')}
                description={t('admin.{{ camelPlural }}.deleteDescription')}
                confirmLabel={t('admin.{{ camelPlural }}.deleteConfirm')}
                cancelLabel={t('admin.{{ camelPlural }}.cancel')}
                closeLabel={t('actions.close')}
                tone="destructive"
                isPending={isDeleting}
                onConfirm={confirmDelete}
            />
        </>
    );
}

Admin{{ Plural }}Index.layout = {
    breadcrumbs: [
        {
            title: 'admin.dashboard',
            href: adminIndex(),
        },
        {
            title: 'admin.{{ camelPlural }}.title',
            href: index(),
        },
    ],
};
