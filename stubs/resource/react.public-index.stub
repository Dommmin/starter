import { router } from '@inertiajs/react';
import {
    Card,
    CardContent,
    EmptyState,
    Grid,
    Heading,
    Link,
    Paginator,
    PublicChrome,
    Section,
    Seo,
    Stack,
    Text,
} from '@/design-system/primitives';
import { useTranslation } from '@/i18n';

/**
 * Public list of published {{ pluralLower }} (generated by
 * `app:make-resource --public`). Rendered on the server like every public page.
 */
export default function Public{{ Plural }}Index({
    items,
    pagination,
    locale,
}: App.Data.Content.Public{{ Model }}ListData) {
    const { t, formatDate } = useTranslation();

    function goToPage(page: number) {
        router.get(window.location.pathname, page > 1 ? { page } : {}, {
            preserveScroll: false,
        });
    }

    return (
        <>
            <Seo
                title={t('{{ camelPlural }}.title')}
                description={t('{{ camelPlural }}.description')}
                robots={pagination.page > 1 ? 'noindex,follow' : undefined}
                jsonLd={{
                    '@context': 'https://schema.org',
                    '@type': 'CollectionPage',
                    name: t('{{ camelPlural }}.title'),
                    description: t('{{ camelPlural }}.description'),
                    inLanguage: locale,
                }}
            />

            <PublicChrome>
                <Section spacing="default" container="wide">
                    <Stack gap="relaxed">
                        <Stack gap="tight">
                            <Heading level={1} variant="page">
                                {t('{{ camelPlural }}.title')}
                            </Heading>
                            <Text variant="lead" tone="muted">
                                {t('{{ camelPlural }}.description')}
                            </Text>
                        </Stack>

                        {items.length === 0 ? (
                            <EmptyState title={t('{{ camelPlural }}.empty')} />
                        ) : (
                            <Grid layout="cards">
                                {items.map((item) => (
                                    <Card key={item.url}>
                                        <CardContent>
                                            <Stack gap="tight">
                                                <Heading level={2} variant="group">
                                                    <Link href={item.url}>
                                                        {item.title}
                                                    </Link>
                                                </Heading>
                                                {item.summary && (
                                                    <Text tone="muted">
                                                        {item.summary}
                                                    </Text>
                                                )}
                                                {item.updatedAt && (
                                                    <Text variant="caption" tone="muted">
                                                        {t('{{ camelPlural }}.updatedOn', {
                                                            date: formatDate(item.updatedAt, {
                                                                dateStyle: 'long',
                                                            }),
                                                        })}
                                                    </Text>
                                                )}
                                            </Stack>
                                        </CardContent>
                                    </Card>
                                ))}
                            </Grid>
                        )}

                        {pagination.totalPages > 1 && (
                            <Paginator
                                page={pagination.page}
                                totalPages={pagination.totalPages}
                                onPageChange={goToPage}
                                previousLabel={t('{{ camelPlural }}.previousPage')}
                                nextLabel={t('{{ camelPlural }}.nextPage')}
                                summary={t('{{ camelPlural }}.paginationSummary', {
                                    page: pagination.page,
                                    total: pagination.totalPages,
                                })}
                            />
                        )}
                    </Stack>
                </Section>
            </PublicChrome>
        </>
    );
}
