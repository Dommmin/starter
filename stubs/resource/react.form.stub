{{ coreImport }}
import { router, useForm } from '@inertiajs/react';
import { useEffect, useState } from 'react';
import {
    Alert,
    Button,
    ConfirmDialog,
    ConflictDialog,
    PageHeader,
    ResourceForm,
    Stack,
{{ typeImports }}
} from '@/design-system/primitives';
{{ pickerImport }}
import { useTranslation } from '@/i18n';
{{ multiSelectImport }}
import {
    destroy,
    edit,
    index,
    store,
    update,
} from '@/routes/admin/{{ kebabPlural }}';

type EditorProps = App.Data.Admin.{{ Plural }}.{{ Model }}EditorData;
type RecordData = App.Data.Admin.{{ Plural }}.{{ Model }}FormData;

/** Values rendered by `ResourceForm`; keys are the request field names. */
type FormValues = {
{{ valueTypes }}
};

{{ stateType }}

const FIELD_NAMES: string[] = [{{ fieldNames }}];

{{ helpers }}
function toState(record: RecordData): FormState {
    return {
{{ toState }}
    };
}

export type {{ Model }}FormProps = {
    editor: EditorProps;
};

/**
 * Shared create/edit screen of a {{ singularLower }}: one `ResourceForm`,
 * optimistic-lock conflict handling and deletion (generated by
 * `app:make-resource`).
 */
export function {{ Model }}Form({ editor }: {{ Model }}FormProps) {
    const record = editor.{{ variable }};
    const recordId = record.id;
    const { can } = editor;
    const { t } = useTranslation();
    const form = useForm<FormState>(toState(record));
    const [isConflictOpen, setIsConflictOpen] = useState(false);
    const [isDeleteOpen, setIsDeleteOpen] = useState(false);
    const [isDeleting, setIsDeleting] = useState(false);

{{ pickerSetup }}
    const errors = form.errors as Partial<Record<string, string>>;
    /** Errors that no field renders inline (e.g. `updated_at`). */
    const generalErrors = Object.keys(errors)
        .filter((key) => key !== 'conflict' && !FIELD_NAMES.includes(key))
        .map((key) => errors[key] ?? '')
        .filter((message) => message !== '');

    useEffect(() => {
        if (!form.isDirty) {
            return;
        }

        return router.on('before', (event) => {
            const visit = event.detail.visit;

            if (
                visit.method !== 'get' ||
                visit.url.pathname === window.location.pathname
            ) {
                return;
            }

            if (!window.confirm(t('admin.{{ camelPlural }}.unsavedChanges'))) {
                event.preventDefault();
            }
        });
    }, [form.isDirty, t]);

    function submit() {
        form.transform((data) => ({
            ...data,
{{ transformFields }}
            ...(recordId !== null ? { updated_at: record.updatedAt ?? '' } : {}),
        }));

        const options = {
            preserveScroll: true,
            onSuccess: () => form.setDefaults(),
            onError: (received: Partial<Record<string, string>>) => {
                if (received.conflict) {
                    setIsConflictOpen(true);
                }
            },
        };

        if (recordId === null) {
            form.submit(store(), options);
        } else {
            form.submit(update(recordId), options);
        }
    }

    function reloadLatest() {
        if (recordId === null) {
            return;
        }

        setIsConflictOpen(false);
        router.visit(edit.url(recordId), { preserveState: false });
    }

    function confirmDelete() {
        if (recordId === null) {
            return;
        }

        setIsDeleting(true);
        router.delete(destroy.url(recordId), {
            onFinish: () => setIsDeleting(false),
        });
    }

    return (
        <Stack gap="relaxed">
            <PageHeader
                title={
                    recordId === null
                        ? t('admin.{{ camelPlural }}.createTitle')
                        : t('admin.{{ camelPlural }}.editTitle')
                }
                description={t('admin.{{ camelPlural }}.description')}
                actions={
                    recordId !== null && can.delete ? (
                        <Button
                            variant="destructive"
                            onClick={() => setIsDeleteOpen(true)}
                        >
                            {t('admin.{{ camelPlural }}.delete')}
                        </Button>
                    ) : undefined
                }
            />

            {generalErrors.length > 0 && (
                <Alert
                    tone="danger"
                    title={t('admin.{{ camelPlural }}.errorSummaryTitle')}
                    description={generalErrors.join(' ')}
                />
            )}

            <ResourceForm<FormValues>
                values={{{ formValues }}}
                errors={errors}
                onChange={(name, value) =>
                    form.setData((data) => ({ ...data, [name]: {{ changeValue }} }))
                }
                onSubmit={submit}
                isPending={form.processing}
                cancelHref={index()}
                labels={{
                    submit: form.processing
                        ? t('admin.{{ camelPlural }}.saving')
                        : t('admin.{{ camelPlural }}.save'),
                    cancel: t('admin.{{ camelPlural }}.cancel'),
                    errorSummaryTitle: t('admin.{{ camelPlural }}.errorSummaryTitle'),
                }}
                sections={[
                    {
                        id: 'details',
                        title: t('admin.{{ camelPlural }}.detailsTitle'),
                        fields: [
{{ formFields }}
                        ],
                    },
                ]}
            />

            {recordId !== null && (
                <ConflictDialog
                    open={isConflictOpen}
                    onOpenChange={setIsConflictOpen}
                    title={t('admin.{{ camelPlural }}.conflictTitle')}
                    description={t('admin.{{ camelPlural }}.conflictDescription')}
                    reloadLabel={t('admin.{{ camelPlural }}.conflictReload')}
                    onReload={reloadLatest}
                    overwriteLabel={t('admin.{{ camelPlural }}.cancel')}
                    onOverwrite={() => setIsConflictOpen(false)}
                />
            )}

            {recordId !== null && can.delete && (
                <ConfirmDialog
                    open={isDeleteOpen}
                    onOpenChange={setIsDeleteOpen}
                    title={t('admin.{{ camelPlural }}.deleteTitle')}
                    description={t('admin.{{ camelPlural }}.deleteDescription')}
                    confirmLabel={t('admin.{{ camelPlural }}.deleteConfirm')}
                    cancelLabel={t('admin.{{ camelPlural }}.cancel')}
                    closeLabel={t('actions.close')}
                    tone="destructive"
                    isPending={isDeleting}
                    onConfirm={confirmDelete}
                />
            )}
        </Stack>
    );
}
