# /etc/logrotate.d/starter — Laravel JSON log in the shared storage.
# Retention follows doc 10 (7 days locally; off-host archive is separate).
/var/www/starter/shared/storage/logs/*.log {
    daily
    rotate 7
    maxsize 200M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    su www-data www-data
    create 0640 www-data www-data
}
