#!/bin/sh
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
    echo 'Brak gitleaks. Zainstaluj przypiętą wersję wskazaną w README i ponów commit.' >&2
    exit 1
fi

gitleaks git --staged --redact --no-banner
exec docker compose --env-file .env.docker run --rm --no-deps app npx lefthook run pre-commit
