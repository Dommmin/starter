# Inertia SSR server (/etc/systemd/system/starter-ssr.service), loopback only
# (port from config/inertia.php, default 13714). deploy:restart_workers runs
# `php artisan inertia:stop-ssr`; systemd starts the new bundle from `current`.
# Not yet ADR-022 step 3 (new SSR next to the old one on another port before
# the switch): during the restart Inertia falls back to client rendering.
[Unit]
Description=starter Inertia SSR
After=network-online.target
Wants=network-online.target
OnFailure=starter-alert@%n.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/starter/current
Environment=LOG_SERVICE=ssr
Environment=NODE_ENV=production
ExecStart=/usr/bin/php /var/www/starter/current/artisan inertia:start-ssr
Restart=always
RestartSec=2
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
