class {{ Model }}Controller extends Controller
{
{{ constants }}
    /**
     * Display the searchable, filterable, paginated list.
     */
    public function index(List{{ Plural }}Request $request): Response
    {
        $listQuery = $request->listQuery();
        $validated = $request->validated();

        $paginator = $listQuery->paginate({{ Model }}::query(){{ with }}, $validated);

        $items = [];
        foreach ($paginator->items() as ${{ variable }}) {
            $items[] = {{ Model }}ListItemData::fromModel(${{ variable }});
        }

        return Inertia::render('admin/{{ kebabPlural }}/index', new {{ Model }}IndexData(
            items: $items,
            pagination: ListPaginationData::from($listQuery->paginationPayload($paginator)),
            filters: {{ Model }}ListFiltersData::from($listQuery->filtersPayload($validated)),
            can: $this->abilities($request, null),
{{ indexArguments }}
        ));
    }

    /**
     * Show the form for a new {{ singularLower }}.
     */
    public function create(Request $request): Response
    {
        return Inertia::render('admin/{{ kebabPlural }}/create', $this->editor($request, {{ Model }}FormData::blank(), null));
    }

    /**
     * Store a new {{ singularLower }}.
     */
    public function store(Store{{ Model }}Request $request): RedirectResponse
    {
        ${{ variable }} = {{ Model }}::query()->create($request->fieldValues());

        Inertia::flash('toast', ['type' => 'success', 'message' => __('admin.{{ camelPlural }}.created')]);

        return to_route('admin.{{ kebabPlural }}.edit', ${{ variable }});
    }

    /**
     * Show the form for editing the {{ singularLower }}.
     */
    public function edit(Request $request, {{ Model }} ${{ variable }}): Response
    {
        return Inertia::render('admin/{{ kebabPlural }}/edit', $this->editor($request, {{ Model }}FormData::fromModel(${{ variable }}), ${{ variable }}));
    }

    /**
     * Update the {{ singularLower }}; a stale `updated_at` yields a `conflict` error.
     */
    public function update(Update{{ Model }}Request $request, {{ Model }} ${{ variable }}, Update{{ Model }} $update{{ Model }}): RedirectResponse
    {
        $update{{ Model }}->handle(${{ variable }}, $request->fieldValues(), $request->expectedUpdatedAt());

        Inertia::flash('toast', ['type' => 'success', 'message' => __('admin.{{ camelPlural }}.updated')]);

        return to_route('admin.{{ kebabPlural }}.edit', ${{ variable }});
    }

    /**
     * Permanently delete the {{ singularLower }} (administrators only).
     */
    public function destroy({{ Model }} ${{ variable }}): RedirectResponse
    {
        ${{ variable }}->delete();

        Inertia::flash('toast', ['type' => 'success', 'message' => __('admin.{{ camelPlural }}.deleted')]);

        return to_route('admin.{{ kebabPlural }}.index');
    }
{{ exportMethods }}

    private function editor(Request $request, {{ Model }}FormData $form, ?{{ Model }} ${{ variable }}): {{ Model }}EditorData
    {
{{ editorOptions }}
        return new {{ Model }}EditorData(
            {{ variable }}: $form,
            can: $this->abilities($request, ${{ variable }}),
{{ editorArguments }}
        );
    }

    private function abilities(Request $request, ?{{ Model }} ${{ variable }}): {{ Model }}AbilitiesData
    {
        $user = $request->user();

        return new {{ Model }}AbilitiesData(
            create: $user?->can('create', {{ Model }}::class) ?? false,
            delete: ${{ variable }} !== null
                ? ($user?->can('delete', ${{ variable }}) ?? false)
                : ($user?->isAdmin() ?? false),
{{ exportAbility }}
        );
    }
{{ optionMethods }}
}
