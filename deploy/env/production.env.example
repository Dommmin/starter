# shared/.env of a single-VM production install (/var/www/starter/shared/.env,
# owner deploy:www-data, mode 0640). scripts/server/provision.sh writes it
# once from this template and never overwrites it; the double-underscore
# placeholders are replaced on the server (random secrets are generated there and never
# printed). Review MAIL_*, OPS_ALERT_EMAIL and the locales before the first
# deploy. Docker-only keys (COMPOSE_*, *_PORT) do not belong here.
APP_NAME="__APP_NAME__"
APP_ENV=production
APP_KEY=__APP_KEY__
APP_DEBUG=false
APP_URL=https://__DOMAIN__
APP_DEMO=false
ADMIN_REQUIRE_TWO_FACTOR=true
APP_REGISTRATION_ENABLED=false
APP_MAINTENANCE_DRIVER=file
APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_PUBLIC_LOCALES=en,pl,de
APP_PUBLIC_DEFAULT=pl
APP_PUBLIC_FALLBACK=en
APP_ACCENT=default
BCRYPT_ROUNDS=12

# ADR-023: JSON file log (rotated by /etc/logrotate.d/starter).
LOG_CHANNEL=stack
LOG_STACK=json
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=starter
DB_USERNAME=starter
DB_PASSWORD=__DB_PASSWORD__
DB_CONNECT_TIMEOUT=5

CACHE_STORE=redis
CACHE_PREFIX=starter-cache-
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=starter-database-
REDIS_TIMEOUT=2

# Showcase default: mail goes to the log. For a working contact form and
# e-mail alerts switch to smtp with an EU provider's credentials.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=null
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_EHLO_DOMAIN=__DOMAIN__
MAIL_FROM_ADDRESS=hello@__DOMAIN__
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Owner decision 2026-10-11: no ClamAV on this host. Uploads are released as
# clean and audited with `scan: skipped`; readiness does not probe clamd.
MEDIA_SCANNER_ENABLED=false
HEALTH_CHECK_SCANNER=false

# CSP stays Report-Only until the report is clean.
CSP_REPORT_ONLY=true

# Operations (config/ops.php, config/horizon.php).
OPS_ALERT_EMAIL=__ALERT_EMAIL__
HEALTH_TOKEN=__HEALTH_TOKEN__
HORIZON_MAX_PROCESSES=2
HORIZON_WAIT_THRESHOLD=300
BACKUP_STATUS_FILE=/var/backups/starter/last-success
