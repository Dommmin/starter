<?php

namespace App\Actions\{{ Plural }};

use App\Models\{{ Model }};
use Illuminate\Support\Carbon;
use Illuminate\Support\Facades\DB;
use Illuminate\Validation\ValidationException;

/**
 * Update a {{ singularLower }} with optimistic locking on `updated_at`.
 */
class Update{{ Model }}
{
    /**
     * @param  array<string, mixed>  $attributes  Validated field values.
     * @param  string  $expectedUpdatedAt  Version the form was loaded with.
{{ relationParamDoc }}
     *
     * @throws ValidationException When the record changed in the meantime (`conflict`).
     */
    public function handle({{ Model }} ${{ variable }}, array $attributes, string $expectedUpdatedAt{{ relationParameter }}): {{ Model }}
    {
        return DB::transaction(function () use (${{ variable }}, $attributes, $expectedUpdatedAt{{ relationUse }}): {{ Model }} {
            $locked = {{ Model }}::query()->whereKey(${{ variable }}->id)->lockForUpdate()->firstOrFail();

            if ($locked->updated_at?->getTimestamp() !== Carbon::parse($expectedUpdatedAt)->getTimestamp()) {
                throw ValidationException::withMessages([
                    'conflict' => __('admin.{{ camelPlural }}.conflict'),
                ]);
            }

            $locked->fill($attributes)
                ->forceFill(['updated_at' => $locked->freshTimestamp()])
                ->save();
{{ syncRelations }}

            return $locked;
        });
    }
}
