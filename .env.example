COMPOSE_PROJECT_NAME=starter-local
APP_PORT=8080
VITE_PORT=5173
MAILPIT_PORT=8025

APP_NAME=Laravel
APP_ENV=local
ADMIN_REQUIRE_TWO_FACTOR=false
# Public demo only (one-click admin, changes refused, hourly reset); never on a client site.
APP_DEMO=false
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# Public site languages (config/localization.php registry); the default and
# fallback must be one of them. `make init-project` can set these keys.
APP_PUBLIC_LOCALES=en,pl,de
APP_PUBLIC_DEFAULT=en
APP_PUBLIC_FALLBACK=en
# Accent colour: default (orange), blue, violet, rose or green.
APP_ACCENT=default
# Self-service sign-up, off by default: administrators invite accounts from
# the panel. app:init-project keeps it off unless --enable-registration is given.
APP_REGISTRATION_ENABLED=false
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
LOG_LEVEL=debug

# Database engine: mysql (default, MySQL 8.4) or pgsql (PostgreSQL 18). The
# Makefile starts the matching Compose service (profile = DB_CONNECTION).
# PostgreSQL: DB_CONNECTION=pgsql, DB_HOST=postgres, DB_PORT=5432.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=starter
DB_USERNAME=starter
DB_PASSWORD=local-development-only
# Local MySQL root (test/e2e databases, restore drill); never used by the app.
# DB_ROOT_PASSWORD=local-development-root

CACHE_STORE=redis
CACHE_PREFIX=starter-cache-
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=starter-database-

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_EHLO_DOMAIN=localhost
MAIL_FROM_ADDRESS=hello@example.test
MAIL_FROM_NAME=Laravel

# Contact form recipient (falls back to MAIL_FROM_ADDRESS); retention in days.
# CONTACT_RECIPIENT=office@example.test
# CONTACT_RETENTION_DAYS=180
# CONTACT_WEBHOOK_URL=https://hooks.example.test/leads
# CONTACT_WEBHOOK_SECRET=  # long random value shared with the receiver
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
VITE_APP_NAME=Laravel

# Content Security Policy (config/csp.php). Report-Only until the report is
# clean on staging; extra origins only for an approved third party, e.g.
# CSP_SCRIPT_SRC=https://plausible.example CSP_CONNECT_SRC=https://plausible.example
# CSP_REPORT_ONLY=true
# CSP_REPORT_URI=
# CSP_SCRIPT_SRC=
# CSP_CONNECT_SRC=

# SEO defaults (config/seo.php); an empty name falls back to the catalog brand, an empty URL to APP_URL.
# SEO_SITE_NAME=
# SEO_DEFAULT_IMAGE=
# SEO_ORGANIZATION_NAME=
# SEO_ORGANIZATION_URL=
# SEO_ORGANIZATION_LOGO=
# SEO_CACHE_MAX_AGE=3600

# Plausible analytics, loaded only after consent in the cookie banner (empty domain = off).
# PLAUSIBLE_DOMAIN=example.com
# PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# DAM (config/media.php). The ClamAV scan of uploads is off by default (uploads
# are released as clean, the skipped scan is audited). To enable it locally set
# both lines below; Docker sets CLAMAV_HOST=clamav for app/queue, the defaults
# fit a native clamd on the same host.
# MEDIA_SCANNER_ENABLED=true
# COMPOSE_PROFILES=clamav
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT=30
# MEDIA_DISK=media
# MEDIA_PUBLIC_DISK=public
# MEDIA_MAX_UPLOAD_KB=51200
# MEDIA_MAX_PIXELS=40000000

# Browser E2E (`make e2e`, local/testing only): password of the synthetic
# e2e-admin/e2e-editor@example.test accounts. Generated per run when unset.
# E2E_PASSWORD=

# Operations (config/ops.php, config/horizon.php). Production values are set
# by the operator; no SaaS is wired (Q7). HEALTH_TOKEN unlocks per-check
# details of /health/ready (X-Health-Token header).
# OPS_ALERT_EMAIL=ops@example.test
# HEALTH_TOKEN=
# HEALTH_CHECK_SCANNER=false
# HORIZON_WAIT_THRESHOLD=300
# HORIZON_MAX_PROCESSES=4
# DB_CONNECT_TIMEOUT=5
# REDIS_TIMEOUT=2
# BACKUP_STATUS_FILE=/var/backups/starter/last-success
# Production logging (ADR-023): LOG_CHANNEL=stack, LOG_STACK=json, LOG_LEVEL=info
