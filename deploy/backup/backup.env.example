# /etc/starter/backup.env — root-owned, mode 0600. Example values only.
# Read by starter-backup.service (scripts/backup/backup.sh). Use a dedicated
# read-only PostgreSQL role for backups (pg_read_all_data) and a separate
# role with CREATEDB for restore drills. BACKUP_DIR must be writable by
# www-data (the unit's user); last-success is read by ops:check-backup.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=starter
PGUSER=starter_backup
PGPASSWORD=change-me

# Local staging directory; ship it off-host (object storage in the EU,
# separate credentials) — see doc 10 "Backup i restore".
BACKUP_DIR=/var/backups/starter
BACKUP_STORAGE_PATH=/var/www/starter/shared/storage/app
BACKUP_STORAGE_DIRS="media public"
BACKUP_KEEP=7
BACKUP_STATUS_FILE=/var/backups/starter/last-success

# Encryption before the files leave the host: none | age | gpg.
BACKUP_ENCRYPT=age
BACKUP_AGE_RECIPIENT=age1examplepublickeyreplacewithoperatorkey0000000000000000000
