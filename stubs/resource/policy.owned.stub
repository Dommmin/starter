<?php

namespace App\Policies;

use App\Models\{{ Model }};
use App\Models\User;

/**
 * {{ pluralLabel }} belong to the user who created them: admins and editors
 * create records, every panel role lists its own, and only the owner (admin
 * or editor) may open, change or delete one. Administrators are not exempt.
 */
class {{ Model }}Policy
{
    /**
     * Determine whether the user can list their own {{ pluralLower }} in the panel.
     */
    public function viewAny(User $user): bool
    {
        return $user->canAccessAdminPanel();
    }

    /**
     * Determine whether the user can create {{ pluralLower }}.
     */
    public function create(User $user): bool
    {
        return $user->canEditContent();
    }

    /**
     * Determine whether the user can edit the {{ singularLower }} (owner only).
     */
    public function update(User $user, {{ Model }} ${{ variable }}): bool
    {
        return $user->canEditContent() && $user->id === ${{ variable }}->user_id;
    }

    /**
     * Determine whether the user can permanently delete the {{ singularLower }} (owner only).
     */
    public function delete(User $user, {{ Model }} ${{ variable }}): bool
    {
        return $user->canEditContent() && $user->id === ${{ variable }}->user_id;
    }
{{ exportMethod }}
}
